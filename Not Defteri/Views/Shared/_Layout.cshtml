<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Not Defteri</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body>
    <aside class="sidebar">
        <div class="d-flex align-items-center justify-content-center py-4">
            <h4 class="m-0 fw-bold">Not Defteri</h4>
        </div>
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
               asp-controller="Notes" asp-action="Index">
                <i class="fas fa-sticky-note me-2"></i> Notlarim
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")"
               asp-controller="Notes" asp-action="Create">
                <i class="fas fa-plus me-2"></i> Yeni Not
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Favorites" ? "active" : "")"
                   asp-controller="Notes" asp-action="Favorites">
                    <i class="fas fa-star me-2"></i> Favorilerim
                </a>
            }
        </nav>
    </aside>

    <div class="main-wrapper d-flex flex-column flex-grow-1">
        <header class="navbar navbar-light bg-white border-bottom">
            <div class="ms-auto d-flex align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="me-3 text-muted">@User.Identity.Name</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-dark btn-sm">Cikis Yap</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary btn-sm me-2">Giris Yap</a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-sm">Kayit Ol</a>
                }
            </div>
        </header>

        <main class="p-4">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
