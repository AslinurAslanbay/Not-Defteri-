@using NotDefteriMvc.Models
@model List<Note>

@{
    ViewData["Title"] = "Favori Notlarım";
}

<h2>Favori Notlarım</h2>

@if (Model == null || !Model.Any())
{
    <p>Henüz favori notunuz yok.</p>
}
else
{
    <div class="row">
        @foreach (var note in Model)
        {
            var words = (note.Description ?? "")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var first10 = string.Join(" ", words.Take(10));
            if (words.Length > 10)
            {
                first10 += "...";
            }

            <div class="col-sm-6 col-md-4 col-lg-3 mb-3">
                <div class="card h-100" style="cursor:pointer;"
                     onclick="window.location='@Url.Action("View", "Notes", new { id = note.Id })'">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@note.Title</h5>
                            <form asp-action="ToggleFavorite" method="post" class="ms-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@note.Id" />
                                <input type="hidden" name="returnToFavorites" value="true" />
                                <button type="submit" class="btn btn-link p-0 border-0"
                                        title="Favoriden kaldır"
                                        onclick="event.stopPropagation();">
                                    <i class="fas fa-star text-warning"></i>
                                </button>
                            </form>
                        </div>
                        <p class="card-text text-muted" style="flex:1;">@first10</p>
                        <small class="text-muted">@note.CreatedDate.ToString("g")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}

