@model NotDefteriMvc.Models.Note

@{
    ViewData["Title"] = Model?.Title ?? "Not Görüntüle";
}



<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label text-muted small">Başlık</label>
            <p class="mb-0 fs-5">@Model?.Title</p>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Açıklama</label>
            <p class="mb-0" style="white-space: pre-wrap;">@(Model?.Description ?? "—")</p>
        </div>

        <div class="mb-0">
            <label class="form-label text-muted small">Oluşturulma Tarihi</label>
            <p class="mb-0">@Model?.CreatedDate.ToString("g")</p>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Düzenle</a>
    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
</div>
