@model NotDefteriMvc.Models.Note

@{
    ViewData["Title"] = "Yeni Not Ekle";
}

<h2>Yeni Not Ekle</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="Title" class="form-label">Baslik</label>
        <input id="Title" name="Title" value="@Model.Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="Description" class="form-label">Aciklama</label>
        <textarea id="Description" name="Description" class="form-control" rows="5">@Model.Description</textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Iptal</a>
</form>
